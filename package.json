{
	"name": "@skeletonlabs/monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"doc": "pnpm --filter @skeletonlabs/skeleton.dev",
		"themes": "pnpm --filter @skeletonlabs/themes.skeleton.dev",
		"plus": "pnpm --filter @skeletonlabs/plus.skeleton.dev",
		"svelte": "pnpm --filter @skeletonlabs/playground-skeleton-svelte",
		"react": "pnpm --filter @skeletonlabs/playground-skeleton-react",
		"test": "vitest run",
		"check": "pnpm --recursive --aggregate-output --reporter=append-only --parallel check",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware --fix",
		"lint:check": "oxlint --type-aware"
	},
	"devDependencies": {
		"@changesets/changelog-github": "catalog:",
		"@changesets/cli": "catalog:",
		"@changesets/config": "catalog:",
		"@playwright/test": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "26.x",
		"pnpm": "12.x"
	},
	"packageManager": "pnpm@12.18.0"
}
