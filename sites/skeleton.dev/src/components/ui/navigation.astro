---
import { resolvePath } from "@/modules/resolve-path";
import { commonSections, type Section } from "@/modules/navigation";
import { removeTrailingSlash } from "@/modules/normalize-path";

interface Props {
	sections?: Section[];
}

const { sections = commonSections } = Astro.props;
---

<div class="grid gap-10 text-sm">
	{sections.map(async (section) => (
		<nav class="flex flex-col gap-2">
			<span class="text-surface-600-400 ml-2 text-[12px] font-bold uppercase">
				{section.label}
			</span>
			<ul class="flex flex-col gap-1">
				{section.docs.map((doc) => (
					<li>
						<a
							href={resolvePath(Astro.params, `/docs/[framework]/${doc.id}`)}
							title={doc.data.title}
							class="btn hover:preset-tonal aria-[current=page]:preset-tonal flex items-center justify-between px-2"
							aria-current={
								removeTrailingSlash(Astro.url.pathname) ===
								resolvePath(Astro.params, `/docs/[framework]/${doc.id}`)
									? "page"
									: "false"
							}
						>
							<span class="text-sm">{doc.data.title}</span>
							{doc.data.stability !== "stable" && (
								<span class="preset-tonal-primary rounded px-1 text-xs capitalize no-underline">
									{doc.data.stability}
								</span>
							)}
						</a>
					</li>
				))}
			</ul>
		</nav>
	))}
</div>
