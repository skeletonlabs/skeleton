---
import { resolvePath } from "@/modules/resolve-path";
import ArrowLeftIcon from "@lucide/astro/icons/arrow-left";
import ArrowRightIcon from "@lucide/astro/icons/arrow-right";
import type { CollectionEntry } from "astro:content";

interface Props {
	previousDoc?: CollectionEntry<"docs">;
	nextDoc?: CollectionEntry<"docs">;
}

const { previousDoc, nextDoc } = Astro.props;
---

<nav class="mt-10 grid grid-cols-2 gap-4">
	<!-- Button: Prev -->
	{previousDoc && (
		<a
			href={resolvePath(Astro.params, `/docs/[framework]/${previousDoc.id}`)}
			class="btn preset-tonal border-surface-200-800 col-start-1 justify-start border py-6"
		>
			<ArrowLeftIcon />
			<div>
				<p class="text-sm opacity-60">Previous</p>
				<p class="text-xs md:text-xl">{previousDoc.data.title}</p>
			</div>
		</a>
	)}
	<!-- Button: Next -->
	{nextDoc && (
		<a
			href={resolvePath(Astro.params, `/docs/[framework]/${nextDoc.id}`)}
			class="btn preset-tonal border-surface-200-800 col-start-2 justify-end border py-6"
		>
			<div class="text-right">
				<p class="text-sm opacity-60">Next</p>
				<p class="text-xs md:text-xl">{nextDoc.data.title}</p>
			</div>
			<ArrowRightIcon />
		</a>
	)}
</nav>
