---
import CheckIcon from "@lucide/astro/icons/check";

interface Props {
	step: string | number;
}

const { step } = Astro.props;
---

<div class="grid grid-cols-[auto_1fr] items-start gap-4">
	<div class="preset-filled-surface-200-800 -ml-4 flex size-7 items-center justify-center rounded-full text-sm">
		{step !== "check" ? step : <CheckIcon class="size-4" />}
	</div>
	<article class="space-y-4 overflow-y-auto [&>.h2]:text-lg! [&>.h3]:text-lg!">
		<slot />
	</article>
</div>
